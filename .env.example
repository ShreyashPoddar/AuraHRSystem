# ── Moodle ─────────────────────────────────────────────
NEXT_PUBLIC_MOODLE_URL=
MOODLE_URL=
MOODLE_ADMIN_TOKEN=
MOODLE_SERVICE=
MOODLE_TOKEN_SERVICE=

# ── Database (Prisma) ──────────────────────────────────
DATABASE_URL=

# ── AI ──────────────────────────────────────────────────
NEEV_API_KEY=

# ── Jitsi / JaaS (video interviews) ─────────────────────
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=

# ── Transcription ────────────────────────────────────────
ASSEMBLYAI_API_KEY=

# ── Keka ATS integration ─────────────────────────────────
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=

# ── Email safety flag ────────────────────────────────────
# true = log intended sends only, no real email goes out.
# false = real emails are sent via SES. Change with care.
EMAIL_DRY_RUN=true

# ── AWS (Textract OCR + SES email) — NOT YET CONFIGURED ──
# Required for real resume parsing (currently falls back to
# mock/placeholder text without these). See handover doc.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
SES_SENDER_EMAIL=

# ── OCR.space (alternative OCR provider, currently unused) ─
OCR_SPACE_API_KEY=
