generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

model Employee {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  role       String
  skills     Json
  department String
  location   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model JobDescription {
  id          String   @id @default(cuid())
  role        String
  description String
  mustHave    Json
  goodToHave  Json
  futureProof Json
  teamGap     Json
  createdAt   DateTime @default(now())
  candidates  Candidate[]
}

model Candidate {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  skills         Json
  experience     Int?
  education      String?
  location       String?
  resumeUrl      String?
  matchScore     Int?
  authenticity   Int?
  status         String   @default("APPLIED")


  // Keka ATS ingestion — stores the originating Keka candidate UUID so we can
  // detect duplicates and correlate back to the source system.
  kekaUuid       String?  @unique

  // Future Match Scoring
  futureProofScore Float?  @default(0)

  // Relations
  jdId             String?
  jobDescription   JobDescription?  @relation(fields: [jdId], references: [id])
  interviews       Interview[]
  proctoringLogs   ProctoringLog[]
  activationTokens ActivationToken[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model Interview {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id])
  scheduledAt     DateTime
  method          String    @default("video")
  status          String    @default("scheduled")
  meetingLink     String?
  aiScore         Float?
  aiFeedback      String?
  createdAt       DateTime  @default(now())
}

model ProctoringLog {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  eventType   String    // TAB_SWITCH, NO_FACE, GAZE_AWAY
  timestamp   DateTime  @default(now())
  severity    String    @default("low")
  metadata    String?   // JSON details
}

model MarketTrend {
  id        String   @id @default(cuid())
  skillName String   @unique
  demand    Float    // 0 to 1
  growth    Float    // Percentage
  updatedAt DateTime @updatedAt
}

// Stores single-use magic-link tokens that let ingested Keka candidates set
// their own password without ever knowing the temporary one provisioned during
// account creation. Token value is a crypto.randomUUID() string, NOT a cuid,
// for higher entropy. Cascades on candidate deletion.
model ActivationToken {
  id          String    @id @default(cuid())
  token       String    @unique
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

